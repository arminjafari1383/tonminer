DJANGO_DEBUG=0
# Comma-separated. Replace * with your domain/IP once it works, e.g. example.com,1.2.3.4
DJANGO_ALLOWED_HOSTS=*

# Needed only if the frontend calls the API from a different origin (not needed with the nginx /api proxy)
