# Guest account creation limit per IP, and number of proxies in front of Django (nginx = 1)
GUEST_RATE=10/hour
NUM_PROXIES=1

# TON payments (deposits return 503 until TON_RECEIVER_ADDRESS is set)
TON_RECEIVER_ADDRESS=UQD5NbzuO-1UXy7rrlKF2Ba0A6HHoT_EbwOxpqJoeyXTEu7Y
TONCENTER_API_URL=https://toncenter.com/api/v2
