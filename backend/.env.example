TELEGRAM_APP_SHORT_NAME=

# Public address of the site (used to build referral links)
PUBLIC_URL=http://144.172.64.107:9000

# 1 = demo/test mode: deposits are simulated and no real TON is moved. Use 0 for live payments.
DEMO_MODE=0

# Minimum withdrawal in TON (default 100). Set a small value such as 1 to test the withdraw flow in demo mode
MIN_WITHDRAW_TON=100
